# --- Base de données (PostgreSQL) ---
# Créer une base sur https://neon.tech (gratuit) et coller sa connection
# string ici — même base pour le développement local et le pilote Vercel
# tant qu'on n'est pas en production finale (LWS).
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# --- Secrets (OBLIGATOIRE de générer des valeurs uniques en production) ---
# Génère chaque secret avec, par exemple : openssl rand -hex 32
AUTH_SECRET="change-me"
ENCRYPTION_KEY="change-me"
CRON_SECRET="change-me"

# --- Email transactionnel (mot de passe oublié) ---
# Créer une clé sur https://resend.com — sans elle, l'app refuse d'envoyer
# de vrais emails et n'affiche le lien de réinitialisation qu'en développement.
RESEND_API_KEY=""
EMAIL_FROM="Manguifi <onboarding@resend.dev>"

# --- URL publique de l'application (utilisée dans les emails) ---
APP_URL="http://localhost:3000"

# --- WhatsApp / SMS (connexion employé, Twilio Verify) ---
# Créer un compte sur https://twilio.com puis un Verify Service
# (Console > Verify > Services > Create). Sans ces clés, l'app refuse
# d'envoyer des codes OTP (message d'erreur explicite côté UI).
# Le canal WhatsApp en production nécessite un expéditeur WhatsApp
# enregistré (Meta) — un compte Twilio "trial" ne peut envoyer qu'aux
# numéros vérifiés dans la console Twilio.
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_VERIFY_SERVICE_SID=""

# --- Relais pilote (temporaire, à retirer dès qu'un domaine est vérifié
# sur Resend) ---
# Sans domaine vérifié, Resend ne peut envoyer QUE vers l'adresse du
# compte Resend lui-même — aucun autre destinataire n'est accepté. Si
# cette variable est renseignée, tous les emails de connexion/invitation
# employé sont redirigés vers cette adresse (avec le vrai destinataire
# indiqué dans le message) pour qu'un admin puisse relayer le code à la
# main pendant un pilote. Ne JAMAIS laisser cette variable en production
# réelle — elle envoie les codes de tout le monde à une seule personne.
EMAIL_OTP_TEST_OVERRIDE_TO=""

# --- Sauvegardes (Vercel Blob) ---
# Créer un Blob store depuis le dashboard Vercel (Storage > Create Database >
# Blob, accès Private) et le connecter au projet — la variable ci-dessous est
# alors ajoutée automatiquement. Sans elle, /api/cron/backup échoue (fail
# closed). BACKUP_RETENTION_DAYS (optionnel, défaut 30) contrôle la purge
# automatique des anciennes sauvegardes.
BLOB_READ_WRITE_TOKEN=""
BACKUP_RETENTION_DAYS="30"

# --- Monitoring (optionnel) ---
# Créer un projet sur https://sentry.io (DSN dans Project Settings > Client
# Keys). Sans ces clés, le code Sentry est déjà en place mais reste inactif
# et les erreurs sont seulement loguées dans la console/les logs du
# conteneur. SENTRY_DSN = erreurs serveur, NEXT_PUBLIC_SENTRY_DSN = erreurs
# navigateur (généralement la même valeur pour les deux).
SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_DSN=""
