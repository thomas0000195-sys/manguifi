<?xml version="1.0" encoding="UTF-8"?>
<!-- Manifeste de confidentialité Apple. À copier dans ios/App/App/PrivacyInfo.xcprivacy.
     À relire avec les données réellement collectées (voir docs/juridique et le schéma Prisma). -->
