# ============================================================================
# MANGUIFI — CONFIGURATION PRODUCTION
# ============================================================================
# Ce fichier contient TOUTES les variables requises pour la production.
# Voir DEPLOIEMENT_COMPTES.md pour les détails de chaque service.
#
# ⚠️ JAMAIS ne mettre les vraies valeurs en clair dans le dépôt.
#    Les valeurs sensibles doivent être ajoutées via:
#    - Variables d'environnement (Vercel, VPS)
#    - Secrets manager (Bitwarden, 1Password)
#    - Fichier .env.local (non versionné)
#
# ============================================================================

# --- 1. BASE DE DONNÉES (Neon.tech) ---
# Remplacer par la vraie connection string Neon
# Format: postgresql://username:password@host.neon.tech/dbname?sslmode=require
DATABASE_URL="postgresql://user:password@ep-XXX.neon.tech/manguifi?sslmode=require"

# --- 2. SECRETS APPLICATIFS ---
# ⚠️ GÉNÉRER DES VALEURS UNIQUES EN PRODUCTION
# Exemple: openssl rand -hex 32
# Ces valeurs doivent être différentes en prod / staging / dev
AUTH_SECRET="change-me-with-unique-prod-value"
ENCRYPTION_KEY="change-me-with-unique-prod-value"
CRON_SECRET="change-me-with-unique-prod-value"

# --- 3. EMAIL (Resend) ---
# Créer une API key sur https://resend.com
# Format: re_XXX...
RESEND_API_KEY="re_XXX..."

# Adresse expéditrice avec domaine vérifié
# Une fois domaine configuré sur Resend, utiliser:
# EMAIL_FROM="Manguifi <noreply@manguifi.sn>"
#
# Pendant pilote (avant vérification domaine):
# EMAIL_FROM="Manguifi <onboarding@resend.dev>"
EMAIL_FROM="Manguifi <onboarding@resend.dev>"

# ⚠️ PILOTE SEULEMENT: Rediriger tous les codes OTP vers une adresse de test
# Utile pendant tests avant vérification domaine Resend.
# JAMAIS en production vraie — expose tous les codes à une seule personne.
# EMAIL_OTP_TEST_OVERRIDE_TO="thomas@example.com"
EMAIL_OTP_TEST_OVERRIDE_TO=""

# --- 4. URL PUBLIQUE ---
# Utilisée dans les liens des emails (réinitialisation mot de passe, invitations)
# Exemple production: https://manguifi.sn
# Exemple staging: https://staging.manguifi.sn
APP_URL="https://manguifi.sn"

# --- 5. OTP WHATSAPP/SMS (Twilio Verify) ---
# Créer un compte Twilio et un Verify Service
# À partir de https://twilio.com (Console > Verify > Services)

# Account SID: Format "ACxxx..." (visible dans Twilio Console)
TWILIO_ACCOUNT_SID="ACxxx..."

# Auth Token: Format long string (visible dans Twilio Console)
TWILIO_AUTH_TOKEN="xxx..."

# Verify Service SID: Format "VAxxx..." (créé lors de la création du Verify Service)
TWILIO_VERIFY_SERVICE_SID="VAxxx..."

# --- 6. SAUVEGARDES (Vercel Blob) ---
# Token de lecture/écriture pour Vercel Blob
# Généré automatiquement quand tu actives Blob dans Vercel dashboard
# Format: vercel_blob_rw_xxx...
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_xxx..."

# Nombre de jours avant suppression automatique des anciennes sauvegardes
# Défaut: 30 jours (recommandé)
BACKUP_RETENTION_DAYS="30"

# --- 7. MONITORING (Sentry) — OPTIONNEL ---
# DSN serveur (backend): Créer un projet Sentry Next.js
# Format: https://xxx@sentry.io/yyyyy
# Laisser vide pour désactiver le monitoring serveur
SENTRY_DSN=""

# DSN navigateur (frontend): Généralement la même valeur que SENTRY_DSN
# Laisser vide pour désactiver le monitoring client
NEXT_PUBLIC_SENTRY_DSN=""

# --- 8. VERCEL (optionnel, détecté automatiquement) ---
# Cette variable est définie automatiquement par Vercel en production
# Ne pas la mettre en .env — c'est juste pour info
# VERCEL="1"

# ============================================================================
# RÉCAPITULATIF DES SOURCES
# ============================================================================
#
# DATABASE_URL       → Neon.tech Console > Connection String
# AUTH_SECRET        → Généré: openssl rand -hex 32
# ENCRYPTION_KEY     → Généré: openssl rand -hex 32
# CRON_SECRET        → Généré: openssl rand -hex 32
# RESEND_API_KEY     → Resend.com > API Keys
# EMAIL_FROM         → Défini par toi (domaine vérifié Resend)
# APP_URL            → URL publique du déploiement
# TWILIO_ACCOUNT_SID → Twilio.com > Account SID
# TWILIO_AUTH_TOKEN  → Twilio.com > Auth Token
# TWILIO_VERIFY_SERVICE_SID → Twilio Console > Verify > Services
# BLOB_READ_WRITE_TOKEN → Vercel Dashboard > Storage > Blob
# SENTRY_DSN         → Sentry.io > Project Settings > Client Keys (optionnel)
#
# ============================================================================
