generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  RESPONSABLE
  EMPLOYEE
}

enum EmployeeStatus {
  ACTIF
  INACTIF
}

enum InvitationStatus {
  EN_ATTENTE
  ACTIVE
}

enum PunchType {
  ARRIVEE
  DEPART
}

enum ConfidenceLevel {
  ELEVE
  A_VERIFIER
}

enum JustificatifMotif {
  MALADIE
  CONGE_PAYE
  CONGE_SANS_SOLDE
  AUTORISATION_EXCEPTIONNELLE
  DEUIL
  AUTRE
}

enum JustificatifStatus {
  EN_ATTENTE
  JUSTIFIE
  REFUSE
  NON_JUSTIFIEE_DEFINITIVE
}

enum PayType {
  PAYE
  NON_PAYE
}

enum OvertimeStatus {
  NON_PLANIFIEE
  PLANIFIEE_A_L_AVANCE
  VALIDEE
  REJETEE
}

// Comment un employé de cette organisation se connecte. WHATSAPP est la
// cible pour la production ; EMAIL existe pour tester avant l'approbation
// Meta d'un expéditeur WhatsApp (ex. pilote IWADA) — configurable par
// organisation, jamais un remplacement global du flux WhatsApp.
enum AuthChannel {
  WHATSAPP
  EMAIL
}

model Organization {
  id                        String   @id @default(cuid())
  name                      String
  createdAt                 DateTime @default(now())
  photoOnPunchEnabled       Boolean  @default(true)
  allowedTimeWindowEnabled  Boolean  @default(false)
  allowedTimeWindowStart    String?
  allowedTimeWindowEnd      String?
  hapticFeedbackEnabled     Boolean  @default(true)
  toleranceMinutes          Int      @default(10)
  justificationDelayDays    Int      @default(3)
  onboardingCompleted       Boolean  @default(false)
  isDemo                    Boolean  @default(false)
  matriculePrefix           String   @default("MGF")
  employeeSequence          Int      @default(0)
  idNumberEnabled           Boolean  @default(false)
  // Purge automatique des pointages/justificatifs anciens. null = désactivé
  // par défaut : les obligations légales de conservation des données de
  // paie varient par pays, donc l'admin doit l'activer explicitement en
  // connaissance de cause plutôt que de subir une suppression par défaut.
  attendanceRetentionMonths Int?
  authChannel               AuthChannel @default(WHATSAPP)

  sites         Site[]
  teams         Team[]
  employees     Employee[]
  users         User[]
  schedules     Schedule[]
  attendances   Attendance[]
  justificatifs Justificatif[]
  auditLogs     AuditLog[]
  overtimes     OvertimeRecord[]
  workSchedules WorkSchedule[]
}

model Site {
  id              String   @id @default(cuid())
  orgId           String
  org             Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  name            String
  address         String?
  latitude        Float?
  longitude       Float?
  radiusMeters    Int      @default(150)
  qrToken         String   @unique @default(cuid())
  qrRegeneratedAt DateTime?
  active          Boolean  @default(true)
  createdAt       DateTime @default(now())

  teams       Team[]
  attendances Attendance[]
  responsables ResponsableSite[]
}

model Team {
  id        String   @id @default(cuid())
  orgId     String
  org       Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  siteId    String
  site      Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)
  name      String
  createdAt DateTime @default(now())

  employees     Employee[]
  schedules     Schedule[]
  responsables  ResponsableTeam[]
}

model Employee {
  id         String         @id @default(cuid())
  orgId      String
  org        Organization   @relation(fields: [orgId], references: [id], onDelete: Cascade)
  teamId     String
  team       Team           @relation(fields: [teamId], references: [id], onDelete: Cascade)
  firstName  String
  lastName   String
  // phone is encrypted at rest (AES-256-GCM) — phoneHash is a deterministic
  // HMAC-SHA256 of the normalized E.164 number, used for exact-match lookup
  // (WhatsApp login) since you can't query an encrypted column directly.
  // Nullable because an EMAIL-auth-channel organization (see
  // Organization.authChannel) logs its employees in by email instead.
  phone      String?
  phoneHash  String?        @unique
  // email is encrypted at rest — emailHash is the equivalent of phoneHash
  // above, used for exact-match lookup when the org's authChannel is EMAIL.
  email      String?
  emailHash  String?        @unique
  position   String?
  status     EmployeeStatus @default(ACTIF)
  photoUrl   String?
  // Unique per organization, not globally — every org defaults to the same
  // "MGF" prefix (Organization.matriculePrefix), so two different companies
  // both on the default WILL produce the same matricule for their first
  // employee. A global @unique here breaks the second org to sign up.
  matricule  String
  // Encrypted at rest (AES-256-GCM, see lib/crypto.ts) — dateOfBirth is
  // stored as an encrypted ISO date string rather than a native DateTime
  // since it's never sorted/filtered by value, only displayed.
  dateOfBirth String?
  idNumber   String?
  invitationStatus InvitationStatus @default(EN_ATTENTE)
  phoneVerifiedAt  DateTime?
  createdAt  DateTime       @default(now())

  user          User?
  schedules     Schedule[]
  attendances   Attendance[]
  justificatifs Justificatif[]
  overtimes     OvertimeRecord[]
  workSchedules WorkSchedule[]
  otpCodes      OTPCode[]
  accessCodes   EmployeeAccessCode[] @relation("employeeAccessCodes")
  session       EmployeeSession?     @relation("employeeSession")

  @@unique([orgId, matricule])
}

model User {
  id           String   @id @default(cuid())
  orgId        String
  org          Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  // Encrypted at rest — emailHash is a deterministic HMAC-SHA256 used for
  // the login lookup, same rationale as phone/phoneHash below.
  email        String?
  emailHash    String?  @unique
  passwordHash String?
  // See Employee.phone/phoneHash above for why both columns exist.
  phone        String?
  phoneHash    String?  @unique
  phoneVerifiedAt DateTime?
  role         Role
  // Tracks acceptance of the CGU/politique de confidentialité — termsVersion
  // is compared against CURRENT_TERMS_VERSION (src/lib/terms.ts) so bumping
  // that constant re-prompts everyone after a material change to the text.
  termsAcceptedAt DateTime?
  termsVersion    String?
  employeeId   String?  @unique
  employee     Employee? @relation(fields: [employeeId], references: [id], onDelete: SetNull)
  createdAt    DateTime @default(now())

  responsableTeams ResponsableTeam[]
  responsableSites ResponsableSite[]
  auditLogs        AuditLog[]
  reviewedJustificatifs Justificatif[] @relation("ReviewedBy")
  correctedAttendances  Attendance[]   @relation("CorrectedBy")
  validatedOvertimes    OvertimeRecord[] @relation("ValidatedBy")
  passwordResetTokens   PasswordResetToken[]
  createdWorkSchedules  WorkSchedule[]
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())
}

model ResponsableTeam {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  teamId String
  team   Team   @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@unique([userId, teamId])
}

model ResponsableSite {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  siteId String
  site   Site   @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@unique([userId, siteId])
}

model Schedule {
  id                String   @id @default(cuid())
  orgId             String
  org               Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  teamId            String?
  team              Team?    @relation(fields: [teamId], references: [id], onDelete: Cascade)
  employeeId        String?
  employee          Employee? @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  daysOfWeek        String
  startTime         String
  endTime           String
  toleranceMinutes  Int      @default(10)
  createdAt         DateTime @default(now())
}

/**
 * A versioned calendar-based work plan for one employee — the irregular-
 * rotation counterpart to Schedule's fixed weekly pattern (see
 * attendance-logic.ts getEffectiveScheduleForDate). Never UPDATE a
 * WorkSchedule that has already been used to compute a past day's status:
 * to change a plan going forward, close this one (set effectiveTo) and
 * create a new one starting the next day, so history never gets
 * recalculated retroactively.
 */
model WorkSchedule {
  id            String    @id @default(cuid())
  orgId         String
  org           Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  employeeId    String
  employee      Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  label         String?
  effectiveFrom DateTime
  effectiveTo   DateTime?
  createdById   String
  createdBy     User      @relation(fields: [createdById], references: [id])
  createdAt     DateTime  @default(now())

  days WorkScheduleDay[]

  @@index([employeeId, effectiveFrom])
}

/** One calendar day within a WorkSchedule — see WorkSchedule for the versioning rule. */
model WorkScheduleDay {
  id               String       @id @default(cuid())
  workScheduleId   String
  workSchedule     WorkSchedule @relation(fields: [workScheduleId], references: [id], onDelete: Cascade)
  date             DateTime
  isWorkingDay     Boolean
  // Required when isWorkingDay = true (enforced in the server action, not
  // the DB) — a repos day has no shift, so no times to set.
  startTime        String?
  endTime          String?
  toleranceMinutes Int          @default(10)

  @@unique([workScheduleId, date])
}

model Attendance {
  id               String          @id @default(cuid())
  orgId            String
  org              Organization    @relation(fields: [orgId], references: [id], onDelete: Cascade)
  employeeId       String
  employee         Employee        @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  siteId           String
  site             Site            @relation(fields: [siteId], references: [id], onDelete: Cascade)
  type             PunchType
  timestamp        DateTime
  confidence       ConfidenceLevel @default(ELEVE)
  photoDataUrl     String?
  latitude         Float?
  longitude        Float?
  deviceFingerprint String?
  isDuplicate      Boolean         @default(false)
  isAnomaly        Boolean         @default(false)
  anomalyType       String?
  correctedById    String?
  correctedBy      User?           @relation("CorrectedBy", fields: [correctedById], references: [id])
  correctionReason String?
  createdAt        DateTime        @default(now())

  @@index([employeeId, timestamp])
}

model OvertimeRecord {
  id              String          @id @default(cuid())
  orgId           String
  org             Organization    @relation(fields: [orgId], references: [id], onDelete: Cascade)
  employeeId      String
  employee        Employee        @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  date            DateTime
  plannedMinutes  Int
  workedMinutes   Int
  overtimeMinutes Int
  status          OvertimeStatus  @default(NON_PLANIFIEE)
  plannedInAdvance Boolean        @default(false)
  validatedById   String?
  validatedBy     User?           @relation("ValidatedBy", fields: [validatedById], references: [id])
  validatedAt     DateTime?
  createdAt       DateTime        @default(now())

  @@unique([employeeId, date])
}

model Justificatif {
  id            String              @id @default(cuid())
  orgId         String
  org           Organization        @relation(fields: [orgId], references: [id], onDelete: Cascade)
  employeeId    String
  employee      Employee            @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  dateStart     DateTime
  dateEnd       DateTime
  motif         JustificatifMotif
  payType       PayType             @default(NON_PAYE)
  documentDataUrl String
  status        JustificatifStatus  @default(EN_ATTENTE)
  comment       String?
  reviewedById  String?
  reviewedBy    User?                @relation("ReviewedBy", fields: [reviewedById], references: [id])
  reviewedAt    DateTime?
  createdAt     DateTime            @default(now())
}

/**
 * Every WhatsApp/SMS OTP verification attempt, successful or not — mainly
 * to spot fraud/typo patterns (a number that never matches any employee,
 * repeated failures). Deliberately NOT scoped to an Organization: an
 * unrecognized number has no org to attach to, which is exactly the case
 * this exists to catch.
 */
model PhoneVerificationAttempt {
  id         String   @id @default(cuid())
  // Encrypted at rest — never queried by exact value, only inserted for
  // fraud-pattern review, so no hash column is needed here.
  phone      String
  outcome    String
  employeeId String?
  createdAt  DateTime @default(now())

  @@index([phone, createdAt])
}

/**
 * One-time email login codes for employees on the EMAIL auth channel —
 * the email equivalent of Twilio Verify for WhatsApp. codeHash is a
 * SHA-256 of the 6-digit code (never stored in the clear, same pattern as
 * PasswordResetToken.tokenHash); emailHash lets us look up the latest
 * pending code for a given address without an encrypted, non-queryable
 * column.
 */
model EmailOtpCode {
  id         String    @id @default(cuid())
  emailHash  String
  codeHash   String
  attempts   Int       @default(0)
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([emailHash, createdAt])
}

model OTPCode {
  id          String    @id @default(cuid())
  employeeId  String
  employee    Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  code        String
  type        String    @default("EMAIL")
  expiresAt   DateTime
  createdAt   DateTime  @default(now())

  @@index([employeeId, createdAt])
}

model AuditLog {
  id         String   @id @default(cuid())
  orgId      String
  org        Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  action     String
  entityType String
  entityId   String
  details    String?
  createdAt  DateTime @default(now())
}

model EmployeeAccessCode {
  id          String    @id @default(cuid())
  employeeId  String
  employee    Employee  @relation("employeeAccessCodes", fields: [employeeId], references: [id], onDelete: Cascade)
  codeHash    String    @unique
  expiresAt   DateTime
  usedAt      DateTime?
  createdBy   String    @default("system")
  createdAt   DateTime  @default(now())

  @@index([employeeId, expiresAt])
}

model EmployeeSession {
  id          String    @id @default(cuid())
  employeeId  String    @unique
  employee    Employee  @relation("employeeSession", fields: [employeeId], references: [id], onDelete: Cascade)
  token       String    @unique
  lastActivityAt DateTime @default(now())
  createdAt   DateTime  @default(now())
}

model EmployeeLoginAttempt {
  id          String    @id @default(cuid())
  phoneHash   String
  outcome     String
  employeeId  String?
  ipAddress   String?
  createdAt   DateTime  @default(now())

  @@index([phoneHash, createdAt])
  @@index([employeeId, createdAt])
}
